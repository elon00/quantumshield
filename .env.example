# Optional server-side AI integration
GEMINI_API_KEY=
# Required with GEMINI_API_KEY for a live Gemini call. Use a model available
# to your account instead of relying on a hard-coded/fallback model name.
GEMINI_MODEL=

# Public application URL used by the production origin guard.
APP_URL=http://localhost:3000

# Hosting platforms may override PORT.
PORT=3000

# In-memory prototype API throttle. Put production rate limiting at the edge or
# in a shared store when horizontally scaling.
API_REQUESTS_PER_MINUTE=120
